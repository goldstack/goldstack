{
  "name": "root",
  "version": "0.1.1",
  "private": true,
  "repository": "git@github.com:goldstack/goldstack.git",
  "license": "MIT",
  "author": "Max Rohde",
  "sideEffects": false,
  "main": "index.js",
  "workspaces": [
    "workspaces/*"
  ],
  "scripts": {
    "build": "tsc -b --force",
    "clean-terraform": "yarn workspaces foreach -W run clean-terraform",
    "commit": "yarn git:commit \"$0\"",
    "compile": "yarn fix-project-references && tsc --build",
    "compile-watch": "tsc -b -w",
    "ensure-no-package-mismatches": "syncpack list-mismatches --config .syncpackrc.js",
    "fix-package-mismatches": "syncpack fix-mismatches --config .syncpackrc.js",
    "fix-project-references": "node --require ./.pnp.cjs scripts/run-ts-node.cjs scripts/fixProjectReferences.ts",
    "format": "biome format --write --json-formatter-enabled=false",
    "format-check": "biome format --json-formatter-enabled=false",
    "generate-docs": "yarn workspace templates-lib generate-docs && yarn workspace docs generate-docs && yarn workspace apps generate-docs",
    "generate-schema": "yarn workspace templates-lib generate-schema && yarn workspace templates-management generate-schema && yarn workspace apps generate-schema",
    "git:set-user": "git config user.email \"$@\" && git submodule foreach --recursive git config user.email \"$@\"",
    "lint": "biome lint --diagnostic-level=error",
    "check": "biome check --json-formatter-enabled=false",
    "check-fix": "biome check --write --json-formatter-enabled=false",
    "lint-fix": "biome lint --write",
    "test": "yarn workspaces foreach -A run test",
    "sync-instructions": "ts-node scripts/syncInstructions.ts",
    "test-watch": "nodemonx --watch . --exec 'yarn test'"
  },
  "resolutions": {
    "generic-names": "4.0.0",
    "node-gyp": "13.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@goldstack/nodemonx": "0.4.44",
    "@goldstack/utils-typescript-references": "0.3.33",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "concurrently": "^10.0.4",
    "markdown-magic": "^4.11.0",
    "nodemon": "^3.1.14",
    "syncpack": "^15.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.17.1"
}
